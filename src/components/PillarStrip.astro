---
import { path } from '../lib/path';
const pillars = [
  {
    index: '01',
    name: 'Digital Assets',
    copy: 'Disciplined exposure to crypto markets — sized, custodied, and risk-managed like any other asset class.',
  },
  {
    index: '02',
    name: 'Gold & Precious Metals',
    copy: "The book's ballast, held for what it has always been: insurance against monetary uncertainty.",
  },
  {
    index: '03',
    name: 'Global Trading',
    copy: 'Systematic, rules-based positioning — active only where inefficiency is real enough to reward it.',
  },
];
---

<section class="pillars">
  <div class="container">
    <p class="section-label" data-reveal>The Book</p>
    <div class="pillars-grid">
      {pillars.map((pillar, i) => (
        <a href={path('/approach')} class="pillar" data-reveal style={`--stagger: ${i + 1}`}>
          <span class="index">{pillar.index}</span>
          <h3>{pillar.name}</h3>
          <p>{pillar.copy}</p>
          <span class="more">Learn more</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars {
    position: relative;
    padding: clamp(48px, 8vh, 88px) 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(26px, 3vw, 40px) clamp(20px, 2.4vw, 34px);
    border-left: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.22s ease;
  }
  .pillar:first-child { border-left: 0; }
  .pillar:hover {
    background: color-mix(in oklab, var(--accent) 7%, transparent);
  }
  /* The index number is the hover cue — it steps up and brightens. */
  .index {
    transition: color 0.24s ease, transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pillar:hover .index {
    transform: translateY(-2px);
  }
  .pillar h3 {
    transition: color 0.24s ease;
  }
  .pillar:hover h3 { color: var(--accent); }
  .more::after {
    content: '→';
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pillar:hover .more::after { transform: translateX(5px); }

  .index {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--accent);
    opacity: 0.85;
  }

  h3 {
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.7vw, 23px);
    font-weight: 400;
    color: var(--text);
  }

  p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
    flex: 1;
  }

  .more {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
    transition: color 0.18s ease;
  }
  .pillar:hover .more { color: var(--accent); }

  @media (max-width: 860px) {
    .pillars-grid { grid-template-columns: 1fr; }
    .pillar {
      padding: 28px 0;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .pillar:first-child { border-top: 0; }
  }
</style>
