---
import { path } from '../lib/path';
---

<section class="teaser">
  <div class="container teaser-inner">
    <p class="eyebrow" data-reveal>Our Philosophy</p>
    <blockquote data-reveal style="--stagger: 1">
      Most capital is lost not to bad markets, but to bad discipline.
    </blockquote>
    <p class="body" data-reveal style="--stagger: 2">
      We combine three exposures that rarely break together, and size every one
      of them before conviction enters the conversation. Downside first; the
      upside is what remains when nothing forces us out of a position.
    </p>
    <a href={path('/strategy')} class="link-arrow">Read our approach</a>
  </div>
</section>

<style>
  .teaser {
    position: relative;
    padding: clamp(44px, 7vh, 80px) 0;
  }
  .teaser-inner > * { max-width: 760px; }

  blockquote {
    font-family: var(--font-serif);
    font-size: clamp(26px, 3.6vw, 44px);
    line-height: 1.22;
    letter-spacing: -0.018em;
    color: var(--text);
    margin: 20px 0 28px;
    text-wrap: balance;
  }

  .body {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.72;
    color: var(--muted);
    max-width: 56ch;
    margin-bottom: 26px;
  }
</style>
