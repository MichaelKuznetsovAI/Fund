---
// Traded universe lives in src/lib/markets.ts — shared with the Strategy page.
// Custody/authorisation detail used to be summarised again here — removed,
// since it already lives in full on /custody and repeating it flattened the
// one place that actually explains it.
import { majors, wider, gold } from '../lib/markets';
---

<section class="coverage">
  <div class="container">
    <p class="section-label" data-reveal>Coverage</p>

    <div class="lead" data-reveal>
      <h2 class="display">The markets we trade.</h2>
      <p>
        A deliberately narrow universe, built for depth rather than breadth
        &mdash; among the deepest, most liquid markets in the world, not a
        scattered basket of positions we could never exit at size. The book
        stays fluid enough to move with the narrative, and concentrated
        enough to act decisively once conviction is there.
      </p>
    </div>

    <!-- Digital assets -->
    <div class="group" data-reveal>
      <p class="group-label">Digital Assets <span>&mdash; held outright</span></p>

      <div class="majors">
        {majors.map((asset, i) => (
          <div class="major" data-reveal style={`--stagger: ${i + 1}`}>
            <span class="ticker">{asset.ticker}</span>
            <span class="name">{asset.name}</span>
          </div>
        ))}
      </div>

      <div class="wider" data-reveal>
        <span class="wider-label">Also traded</span>
        <ul>
          {wider.map((ticker) => <li>{ticker}</li>)}
        </ul>
      </div>
    </div>

    <!-- Gold, held apart: it is a separate mandate, run on opposite
         principles, so it does not belong in the digital-asset row. -->
    <div class="group gold-group" data-reveal>
      <p class="group-label">Gold <span>&mdash; actively traded, multi-manager</span></p>
      <div class="gold">
        <div class="gold-id">
          <span class="ticker">{gold.ticker}</span>
          <span class="name">{gold.name}</span>
        </div>
        <p class="gold-note">
          Traded as its own mandate by a specialist desk of experienced
          trading professionals. It is not held here as a passive store of
          value.
        </p>
      </div>

      <!-- Replaces the stray hero solid that used to drift into view here
           (see HeroObjects' journeyFade — it now reaches true zero instead of
           a permanent floor). Facts only, restated from the copy above —
           nothing new asserted, no tagline. -->
      <div class="gold-ticker" aria-hidden="true">
        <div class="gold-ticker-track">
          <span class="gold-badge"><i></i>Actively Traded</span>
          <span class="gold-badge"><i></i>Specialist Desk</span>
          <span class="gold-badge"><i></i>Experienced Professionals</span>
          <span class="gold-badge"><i></i>Multi-Manager</span>
          <span class="gold-badge"><i></i>Not a Passive Holding</span>
          <!-- duplicated once, so translating the track by exactly -50% loops seamlessly -->
          <span class="gold-badge"><i></i>Actively Traded</span>
          <span class="gold-badge"><i></i>Specialist Desk</span>
          <span class="gold-badge"><i></i>Experienced Professionals</span>
          <span class="gold-badge"><i></i>Multi-Manager</span>
          <span class="gold-badge"><i></i>Not a Passive Holding</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .coverage {
    position: relative;
    padding: clamp(40px, 6vh, 72px) 0;
  }

  .lead {
    max-width: 620px;
    margin-bottom: clamp(32px, 4vh, 48px);
  }
  .lead h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    margin-bottom: 18px;
  }
  .lead p {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.7;
    color: var(--muted);
    max-width: 52ch;
  }

  .group + .group { margin-top: clamp(34px, 4vh, 52px); }

  /* 11px, not the 10px used for one-word section tags: these labels carry a
     full descriptive phrase and have to stay comfortably readable. */
  .group-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .group-label span {
    color: var(--muted);
    opacity: 0.8;
  }

  .majors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }
  .major {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(22px, 2.6vw, 32px) clamp(16px, 2vw, 28px);
    border-left: 1px solid var(--border);
    transition: background-color 0.22s ease;
  }
  .major:first-child { border-left: 0; }
  .major:hover { background: color-mix(in oklab, var(--accent) 7%, transparent); }

  .ticker {
    font-family: var(--font-mono);
    font-size: clamp(20px, 2.2vw, 27px);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .name {
    font-size: 13px;
    color: var(--muted);
  }

  .wider {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }
  .wider-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    flex-shrink: 0;
  }
  .wider ul {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wider li {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text);
    border: 1px solid var(--border);
    padding: 6px 10px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .wider li:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Gold sits in its own frame rather than as a fourth crypto tile. */
  .gold {
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    flex-wrap: wrap;
    padding: clamp(22px, 2.6vw, 30px) 0;
    border-block: 1px solid var(--border);
  }
  .gold-id {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 120px;
  }

  /* Slow, seamless drift — a fact ticker, not an attention-grabber. The mask
     fades each edge so badges don't hard-cut at the container boundary. */
  .gold-ticker {
    overflow: hidden;
    padding: 16px 0 20px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .gold-ticker-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: goldTickerDrift 32s linear infinite;
  }
  @keyframes goldTickerDrift {
    to { transform: translateX(-50%); }
  }
  /* Spacing lives on the item (margin), not the container (gap). The track
     is two identical sets back to back for a seamless loop, and -50% is only
     exactly the seam when both halves are structurally identical down to
     their own trailing space — a shared `gap` on the flex container adds one
     extra gap at the seam that isn't inside either half, which threw the
     split off by half a gap and showed up as a visible jump on each loop. */
  .gold-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-right: 30px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .gold-badge i {
    display: block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .gold-note {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 58ch;
    flex: 1;
  }

  @media (max-width: 560px) {
    .majors { grid-template-columns: 1fr; }
    .major {
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
    .major:last-child { border-bottom: 0; }
    .gold { gap: 18px; }
  }
</style>
