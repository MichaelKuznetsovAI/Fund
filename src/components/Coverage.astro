---
// PLACEHOLDER CONTENT — confirm before launch.
//
// The digital-asset list is drawn from the CoinGecko market-cap ranking
// (snapshot: 1 Sep 2026), filtered down to assets a fund would actually take a
// position in. Deliberately excluded, and easy to add back if wrong:
//
//   stablecoins (USDT, USDC, DAI, USDS, USDe, PYUSD, RLUSD, USDG, USDY …)
//     — settlement instruments, not positions. Listing them as markets we
//       trade would misrepresent the book.
//   tokenised funds / RWA (BUIDL, USYC, Figure Heloc, Canton, Rain)
//     — institutional products, not assets this strategy swing-trades.
//   exchange tokens (LEO, WBT, OKB, CRO)
//     — holding them adds venue counterparty risk to a book built to avoid it.
//   memecoins (SHIB, MemeCore)
//     — DOGE is kept as a genuinely liquid market; the smaller ones read badly
//       next to copy about discipline. One line to restore if they are traded.
//   XAUT (Tether Gold) — tokenised gold would blur the line with the gold
//     sleeve, which is traded as a separate mandate entirely.
//
// NOTE: XMR and ZEC are included as major markets, but many custodians and
// venues will not support privacy coins — worth confirming against the actual
// custodian before this goes live.
//
// Tickers are set in the mono face rather than dropped in as third-party brand
// logos. Those logos are full-colour and would fight the palette on every row,
// and reproducing them drags in trademark questions this site does not need.

const majors = [
  { ticker: 'BTC', name: 'Bitcoin' },
  { ticker: 'ETH', name: 'Ethereum' },
  { ticker: 'SOL', name: 'Solana' },
];

const wider = [
  'BNB', 'XRP', 'TRX', 'HYPE', 'DOGE', 'LINK', 'ADA', 'XLM', 'BCH', 'GRAM',
  'LTC', 'UNI', 'HBAR', 'AVAX', 'SUI', 'NEAR', 'TAO', 'AAVE', 'XMR', 'ZEC',
];

const infrastructure = [
  { label: 'Custody', value: 'Independent third party, off exchange' },
  { label: 'Authorisation', value: 'Multi-signature — three independent keys' },
  { label: 'Leverage', value: 'None on digital assets' },
  { label: 'Provider', value: '[Custodian — to confirm]' },
];
---

<section class="coverage">
  <div class="container">
    <p class="section-label" data-reveal>Coverage</p>

    <div class="lead" data-reveal>
      <h2 class="display">The markets we trade.</h2>
      <p>
        A deliberately narrow universe. Depth in a handful of liquid markets
        beats breadth across assets we cannot exit at size.
      </p>
    </div>

    <!-- Digital assets -->
    <div class="group" data-reveal>
      <p class="group-label">Digital Assets <span>&mdash; spot, unleveraged</span></p>

      <div class="majors">
        {majors.map((asset, i) => (
          <div class="major" data-reveal style={`--stagger: ${i + 1}`}>
            <span class="ticker">{asset.ticker}</span>
            <span class="name">{asset.name}</span>
          </div>
        ))}
      </div>

      <div class="wider" data-reveal>
        <span class="wider-label">Also traded</span>
        <ul>
          {wider.map((ticker) => <li>{ticker}</li>)}
        </ul>
      </div>
    </div>

    <!-- Gold, held apart: it is a separate mandate, run on opposite
         principles, so it does not belong in the digital-asset row. -->
    <div class="group gold-group" data-reveal>
      <p class="group-label">Gold <span>&mdash; actively traded, multi-manager</span></p>
      <div class="gold">
        <div class="gold-id">
          <span class="ticker">XAU</span>
          <span class="name">Gold</span>
        </div>
        <p class="gold-note">
          Traded as its own mandate by a specialist desk, with capital divided
          across several independent traders. It is not held here as a passive
          store of value.
        </p>
      </div>
    </div>

    <dl class="infra" data-reveal>
      {infrastructure.map((row) => (
        <div class="infra-row">
          <dt>{row.label}</dt>
          <dd>{row.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .coverage {
    position: relative;
    padding: clamp(40px, 6vh, 72px) 0;
  }

  .lead {
    max-width: 620px;
    margin-bottom: clamp(32px, 4vh, 48px);
  }
  .lead h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    margin-bottom: 18px;
  }
  .lead p {
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.7;
    color: var(--muted);
    max-width: 52ch;
  }

  .group + .group { margin-top: clamp(34px, 4vh, 52px); }

  /* 11px, not the 10px used for one-word section tags: these labels carry a
     full descriptive phrase and have to stay comfortably readable. */
  .group-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .group-label span {
    color: var(--muted);
    opacity: 0.8;
  }

  .majors {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }
  .major {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(22px, 2.6vw, 32px) clamp(16px, 2vw, 28px);
    border-left: 1px solid var(--border);
    transition: background-color 0.22s ease;
  }
  .major:first-child { border-left: 0; }
  .major:hover { background: color-mix(in oklab, var(--accent) 7%, transparent); }

  .ticker {
    font-family: var(--font-mono);
    font-size: clamp(20px, 2.2vw, 27px);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .name {
    font-size: 13px;
    color: var(--muted);
  }

  .wider {
    display: flex;
    align-items: baseline;
    gap: 20px;
    flex-wrap: wrap;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
  }
  .wider-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    flex-shrink: 0;
  }
  .wider ul {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wider li {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text);
    border: 1px solid var(--border);
    padding: 6px 10px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .wider li:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Gold sits in its own frame rather than as a fourth crypto tile. */
  .gold {
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    flex-wrap: wrap;
    padding: clamp(22px, 2.6vw, 30px) 0;
    border-block: 1px solid var(--border);
  }
  .gold-id {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 120px;
  }
  .gold-note {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 58ch;
    flex: 1;
  }

  .infra {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    /* was 1px — the columns collided and the values ran together */
    gap: 12px clamp(24px, 3vw, 44px);
    margin: 0;
    padding-top: clamp(28px, 4vh, 40px);
  }
  .infra-row {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .infra dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .infra dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .infra { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 24px; }
  }
  @media (max-width: 560px) {
    .majors { grid-template-columns: 1fr; }
    .major {
      border-left: 0;
      border-bottom: 1px solid var(--border);
    }
    .major:last-child { border-bottom: 0; }
    .infra { grid-template-columns: 1fr; }
    .gold { gap: 18px; }
  }
</style>
