---
// The mark is the name: two heavy iron clamps holding a core between them.
// "Hold" is the verb the whole fund is built on — the brackets grip, the
// asset sits secure in the middle and never has to be let go.
// Drawn on a 24-unit grid so it stays crisp at favicon size.
interface Props {
  size?: number;
  showWordmark?: boolean;
}
const { size = 22, showWordmark = true } = Astro.props;
---

<span class="logo">
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="mark"
  >
    <!-- clamps -->
    <path d="M9 3.2H4.6a1 1 0 0 0-1 1v15.6a1 1 0 0 0 1 1H9" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
    <path d="M15 3.2h4.4a1 1 0 0 1 1 1v15.6a1 1 0 0 1-1 1H15" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
    <!-- the held core -->
    <rect x="12" y="8.1" width="5.5" height="5.5" rx="0.6" transform="rotate(45 12 8.1)" fill="currentColor" />
  </svg>
  {showWordmark && <span class="wordmark">IRON HOLD CAPITAL</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--accent);
  }

  .mark {
    flex-shrink: 0;
    /* the clamps close a touch on hover — the mark performs its own verb */
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(a:hover) .mark {
    transform: scale(0.94);
  }

  .wordmark {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--text);
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .wordmark { font-size: 12px; letter-spacing: 0.12em; }
  }
</style>
