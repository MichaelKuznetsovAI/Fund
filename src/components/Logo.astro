---
// Faceted fist mark. Source art: "05 - Faceted Line Fist.png" (2048x2048,
// solid #F3F7F8 backing, no alpha) — background keyed out to alpha and
// cropped to the icon alone in design-logo/, since the source flattens the
// mark and the "IRON HAND CAPITAL" wordmark into one image and this
// component needs just the mark (the wordmark stays live text below, so it
// keeps resizing and following theme color).
//
// Unlike the bar-hand mark this replaces, the ink (navy line + teal facets)
// is baked into the raster, not currentColor — it will not repaint across
// palettes or dark mode. The "unfilled" facets were keyed transparent along
// with the true background, so on dark surfaces they show through as dark
// rather than staying light — the two-tone facet contrast is a light-theme
// effect. No per-finger hover interaction either: that relied on separate
// stroke elements a raster doesn't have.
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-mark.png';

interface Props {
  size?: number;
  showWordmark?: boolean;
}
const { size = 26, showWordmark = true } = Astro.props;
---

<span class="logo">
  <Image
    src={logoMark}
    alt=""
    width={logoMark.width}
    height={logoMark.height}
    class="logo-mark"
    style={`height: ${size}px; width: auto;`}
  />
  {showWordmark && <span class="wordmark">IRON HAND CAPITAL</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--accent);
  }

  .logo-mark {
    flex-shrink: 0;
    display: block;
  }

  .wordmark {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--text);
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .wordmark { font-size: 12px; letter-spacing: 0.12em; }
  }
</style>
