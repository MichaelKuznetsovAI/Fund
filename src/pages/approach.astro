---
// Overview hub. Each pillar now has its own page — this introduces the three
// and routes to them, rather than stacking all of their detail in one place.
import Layout from '../layouts/Layout.astro';
import { path } from '../lib/path';
import { pillars } from '../lib/pillars';
---

<Layout title="Our Approach — Iron Hand Capital">
  <section class="page-header container">
    <p class="eyebrow" data-reveal>Our Approach</p>
    <h1 data-reveal style="--stagger: 1">Two markets, opposite disciplines.</h1>
    <p class="intro" data-reveal style="--stagger: 2">
      Gold is traded actively and spread across several hands. Digital assets
      are bought outright and held without leverage. The two are run on
      deliberately opposite principles, and both sit behind the same custody.
    </p>
  </section>

  <section class="cards container">
    {pillars.map((p, i) => (
      <a href={path(p.slug)} class="card" data-reveal style={`--stagger: ${i + 1}`}>
        <span class="index">{p.index}</span>
        <h2>{p.name}</h2>
        <p class="card-title">{p.title}</p>
        <p class="card-copy">{p.card}</p>
        <span class="go">Read in full</span>
      </a>
    ))}
  </section>
</Layout>

<style>
  .page-header { padding-block: 64px 40px; }
  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(32px, 4vw, 46px);
    color: var(--text);
    margin-top: 16px;
    max-width: 18ch;
  }
  .intro {
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.7;
    color: var(--muted);
    max-width: 62ch;
    margin-top: 22px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
    margin-bottom: clamp(56px, 8vh, 104px);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(26px, 3vw, 38px) clamp(20px, 2.4vw, 32px);
    border-left: 1px solid var(--border);
    text-decoration: none;
    transition: background-color 0.22s ease;
  }
  .card:first-child { border-left: 0; }
  .card:hover { background: color-mix(in oklab, var(--accent) 7%, transparent); }

  .index {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--accent);
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(21px, 2vw, 26px);
    color: var(--text);
    transition: color 0.22s ease;
  }
  .card:hover h2 { color: var(--accent); }

  .card-title {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
  }
  .card-copy {
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
    flex: 1;
  }

  .go {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 4px;
    transition: color 0.18s ease;
  }
  .go::after {
    content: '→';
    display: inline-block;
    margin-left: 6px;
    transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .go { color: var(--accent); }
  .card:hover .go::after { transform: translateX(5px); }

  @media (max-width: 860px) {
    .cards { grid-template-columns: 1fr; }
  }
</style>
